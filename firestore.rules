rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string &&
        request.auth.token.email.size() <= 120;
    }

    function emailToKey(email) {
      return email.lower().replace('[^a-z0-9]', '_');
    }

    function isSuperAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'champ5698@gmail.com';
    }

    function hasAuthorizedRole(roles) {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/authorized_users/$(emailToKey(request.auth.token.email))) &&
        get(/databases/$(database)/documents/authorized_users/$(emailToKey(request.auth.token.email))).data.active == true &&
        get(/databases/$(database)/documents/authorized_users/$(emailToKey(request.auth.token.email))).data.role in roles;
    }

    function isAdmin() {
      return isSuperAdmin() || hasAuthorizedRole(['admin']);
    }

    function isAuthorizedEditor() {
      return isSuperAdmin() || hasAuthorizedRole(['admin', 'editor']);
    }

    function isSharedWorkspace(workspaceId) {
      return workspaceId == 'pea-fang-shared';
    }

    function isValidSheet(data) {
      return data.keys().hasAll([
        'sheetNo',
        'title',
        'feederCode',
        'substation',
        'description',
        'transformers',
        'switches',
        'feederPaths',
        'annotations',
        'workspaceId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sheetNo',
        'title',
        'feederCode',
        'substation',
        'description',
        'transformers',
        'switches',
        'feederPaths',
        'annotations',
        'workspaceId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.sheetNo is string && data.sheetNo.size() >= 1 && data.sheetNo.size() <= 32 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
      data.feederCode is string && data.feederCode.size() <= 64 &&
      data.substation is string && data.substation.size() <= 200 &&
      data.description is string && data.description.size() <= 500 &&
      data.transformers is list && data.transformers.size() <= 300 && (data.transformers.size() == 0 || data.transformers[0] is map) &&
      data.switches is list && data.switches.size() <= 200 && (data.switches.size() == 0 || data.switches[0] is map) &&
      data.feederPaths is list && data.feederPaths.size() <= 200 && (data.feederPaths.size() == 0 || data.feederPaths[0] is map) &&
      data.annotations is list && data.annotations.size() <= 200 && (data.annotations.size() == 0 || data.annotations[0] is map) &&
      isValidId(data.workspaceId) &&
      isSharedWorkspace(data.workspaceId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidDraft(data) {
      return data.keys().hasAll([
        'sheetId',
        'actionType',
        'transformerData',
        'requesterName',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sheetId',
        'actionType',
        'targetTransformerId',
        'transformerData',
        'originalData',
        'requesterName',
        'requesterContact',
        'requestNotes',
        'status',
        'reviewedBy',
        'reviewedAt',
        'reviewNote',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.sheetId) &&
      (data.actionType == 'create' || data.actionType == 'update') &&
      data.transformerData is map &&
      data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120 &&
      (!('requesterContact' in data) || (data.requesterContact is string && data.requesterContact.size() <= 120)) &&
      (!('requestNotes' in data) || (data.requestNotes is string && data.requestNotes.size() <= 500)) &&
      (!('targetTransformerId' in data) || (data.targetTransformerId is string && data.targetTransformerId.size() <= 128)) &&
      (!('originalData' in data) || (data.originalData is map)) &&
      (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
      (!('reviewedAt' in data) || (data.reviewedAt is timestamp)) &&
      (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 500)) &&
      (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAuthorizedUser(data) {
      return data.keys().hasAll([
        'email',
        'displayName',
        'role',
        'active',
        'addedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'email',
        'displayName',
        'role',
        'active',
        'addedBy',
        'createdAt',
        'updatedAt'
      ]) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
      data.email == data.email.lower() &&
      data.displayName is string && data.displayName.size() <= 120 &&
      (data.role == 'admin' || data.role == 'editor') &&
      data.active is bool &&
      data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 120 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /sheets/{sheetId} {
      // Public read allowed so View-Only links and diagrams display without login
      allow read: if true;

      // Only verified authorized editors or admins can create/update sheets
      allow create: if isVerifiedUser() &&
        isValidId(sheetId) &&
        isValidSheet(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedEditor();

      allow update: if isVerifiedUser() &&
        isValidId(sheetId) &&
        isValidSheet(incoming()) &&
        isSharedWorkspace(existing().workspaceId) &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'sheetNo',
          'title',
          'feederCode',
          'substation',
          'description',
          'transformers',
          'switches',
          'feederPaths',
          'annotations',
          'updatedAt'
        ]) &&
        isAuthorizedEditor();

      // Only verified admins can delete sheets
      allow delete: if isVerifiedUser() &&
        isValidId(sheetId) &&
        isSharedWorkspace(existing().workspaceId) &&
        isAdmin();
    }

    match /transformer_drafts/{draftId} {
      allow get: if isValidId(draftId);
      allow list: if true;

      // Viewers and staff can submit a pending draft
      allow create: if isValidId(draftId) &&
        isValidDraft(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Only verified authorized editors or admins can approve or reject pending drafts
      allow update: if isVerifiedUser() &&
        isValidId(draftId) &&
        isValidDraft(incoming()) &&
        existing().status == 'pending' &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'reviewedBy',
          'reviewedAt',
          'reviewNote',
          'updatedAt'
        ]) &&
        isAuthorizedEditor();

      // Only verified admins can delete drafts
      allow delete: if isVerifiedUser() &&
        isValidId(draftId) &&
        isAdmin();
    }

    match /authorized_users/{userKey} {
      // Users can check their own authorization record; Super Admin can read any
      allow get: if isVerifiedUser() &&
        isValidId(userKey) &&
        (userKey == emailToKey(request.auth.token.email) || isSuperAdmin());

      // Super Admin can list all authorized staff; regular verified user can only query their own email
      allow list: if isSuperAdmin() ||
        (isVerifiedUser() && existing().email == request.auth.token.email.lower());

      allow create: if isSuperAdmin() &&
        isValidId(userKey) &&
        isValidAuthorizedUser(incoming()) &&
        emailToKey(incoming().email) == userKey &&
        incoming().addedBy == request.auth.token.email.lower() &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSuperAdmin() &&
        isValidId(userKey) &&
        isValidAuthorizedUser(incoming()) &&
        incoming().email == existing().email &&
        incoming().addedBy == existing().addedBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'role',
          'active',
          'updatedAt'
        ]);

      allow delete: if isSuperAdmin() &&
        isValidId(userKey);
    }
  }
}
