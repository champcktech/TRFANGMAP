rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSharedWorkspace(workspaceId) {
      return workspaceId == 'pea-fang-shared';
    }

    function isValidSheet(data) {
      return data.keys().hasAll([
        'sheetNo',
        'title',
        'feederCode',
        'substation',
        'description',
        'transformers',
        'switches',
        'feederPaths',
        'annotations',
        'workspaceId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sheetNo',
        'title',
        'feederCode',
        'substation',
        'description',
        'transformers',
        'switches',
        'feederPaths',
        'annotations',
        'workspaceId',
        'createdAt',
        'updatedAt'
      ]) &&
      data.sheetNo is string && data.sheetNo.size() >= 1 && data.sheetNo.size() <= 32 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
      data.feederCode is string && data.feederCode.size() <= 64 &&
      data.substation is string && data.substation.size() <= 200 &&
      data.description is string && data.description.size() <= 500 &&
      data.transformers is list && data.transformers.size() <= 300 && (data.transformers.size() == 0 || data.transformers[0] is map) &&
      data.switches is list && data.switches.size() <= 200 && (data.switches.size() == 0 || data.switches[0] is map) &&
      data.feederPaths is list && data.feederPaths.size() <= 200 && (data.feederPaths.size() == 0 || data.feederPaths[0] is map) &&
      data.annotations is list && data.annotations.size() <= 200 && (data.annotations.size() == 0 || data.annotations[0] is map) &&
      isValidId(data.workspaceId) &&
      isSharedWorkspace(data.workspaceId) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidDraft(data) {
      return data.keys().hasAll([
        'sheetId',
        'actionType',
        'transformerData',
        'requesterName',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sheetId',
        'actionType',
        'targetTransformerId',
        'transformerData',
        'originalData',
        'requesterName',
        'requesterContact',
        'requestNotes',
        'status',
        'reviewedBy',
        'reviewedAt',
        'reviewNote',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.sheetId) &&
      (data.actionType == 'create' || data.actionType == 'update') &&
      data.transformerData is map &&
      data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120 &&
      (!('requesterContact' in data) || (data.requesterContact is string && data.requesterContact.size() <= 120)) &&
      (!('requestNotes' in data) || (data.requestNotes is string && data.requestNotes.size() <= 500)) &&
      (!('targetTransformerId' in data) || (data.targetTransformerId is string && data.targetTransformerId.size() <= 128)) &&
      (!('originalData' in data) || (data.originalData is map)) &&
      (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
      (!('reviewedAt' in data) || (data.reviewedAt is timestamp)) &&
      (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() <= 500)) &&
      (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /sheets/{sheetId} {
      allow get: if isValidId(sheetId) && (resource == null || isSharedWorkspace(existing().workspaceId));
      allow list: if existing().workspaceId == 'pea-fang-shared';

      allow create: if request.auth != null &&
        isValidId(sheetId) &&
        isValidSheet(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if request.auth != null &&
        isValidId(sheetId) &&
        isValidSheet(incoming()) &&
        isSharedWorkspace(existing().workspaceId) &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'sheetNo',
          'title',
          'feederCode',
          'substation',
          'description',
          'transformers',
          'switches',
          'feederPaths',
          'annotations',
          'updatedAt'
        ]);

      allow delete: if request.auth != null &&
        isValidId(sheetId) &&
        isSharedWorkspace(existing().workspaceId);
    }

    match /transformer_drafts/{draftId} {
      allow get: if isValidId(draftId);
      allow list: if true;

      // Unauthenticated guests and logged-in users can both submit a pending draft
      allow create: if isValidId(draftId) &&
        isValidDraft(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Only authenticated admin users can approve or reject drafts
      allow update: if request.auth != null &&
        isValidId(draftId) &&
        isValidDraft(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'reviewedBy',
          'reviewedAt',
          'reviewNote',
          'updatedAt'
        ]);

      // Only authenticated admin users can delete drafts
      allow delete: if request.auth != null && isValidId(draftId);
    }
  }
}
